---
// Este componente maneja la lógica para mostrar/ocultar el header al hacer scroll
---

<script>
  // Lógica para mostrar/ocultar el header al hacer scroll
  class HeaderScroll {
    private header: HTMLElement | null;
    private isVisible: boolean;
    private lastScrollY: number;
    
    constructor(headerId: string) {
      this.header = document.getElementById(headerId);
      this.isVisible = true;
      this.lastScrollY = 0;
      
      this.init();
    }
    
    private init(): void {
      if (!this.header) return;
      
      window.addEventListener('scroll', this.handleScroll.bind(this), { passive: true });
    }
    
    private handleScroll(): void {
      if (!this.header) return;
      
      const currentScrollY = window.scrollY;
      const scrollingDown = currentScrollY > this.lastScrollY;
      const scrolledEnough = Math.abs(currentScrollY - this.lastScrollY) > 10;
      
      if (scrolledEnough) {
        this.isVisible = !scrollingDown || currentScrollY < 100;
        
        if (this.isVisible) {
          this.header.classList.add('header-visible');
          this.header.classList.remove('header-hidden');
        } else {
          this.header.classList.add('header-hidden');
          this.header.classList.remove('header-visible');
        }
        
        this.lastScrollY = currentScrollY;
      }
    }
  }
  
  // Inicializar el controlador de scroll cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', () => {
    new HeaderScroll('header');
  });
</script>