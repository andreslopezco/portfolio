---
import { Button } from "@/components/ui/button";
import { ArrowRight } from "lucide-react";
import ParticlesComponent from "./Particles";
import FadeIn from "./FadeIn";
---

<style>
  .shimmer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      110deg,
      rgba(255, 255, 255, 0) 10%,
      rgba(255, 255, 255, 0.2) 45%,
      rgba(255, 255, 255, 0.2) 55%,
      rgba(255, 255, 255, 0) 90%
    );
    animation: shimmer 2s infinite;
  }

  @keyframes shimmer {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(100%);
    }
  }
</style>

<section
  id="home"
  class="relative text-foreground w-full min-h-[90vh] flex items-center"
  aria-label="Presentación principal"
>
  <div class="absolute inset-0 w-full h-full">
    <ParticlesComponent client:load />
  </div>
  <div class="container mx-auto px-4 relative z-10 h-full flex items-center justify-center">
    <div class="max-w-3xl text-center">
      <FadeIn client:load>
        <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">
          ¡Hola, soy Andrés 👋!
        </h1>
      </FadeIn>
      <FadeIn client:load delay={0.2}>
        <p class="text-lg md:text-xl text-muted-foreground mb-8">
          Creo contenido sobre tecnología, servidores, homelabs y
          automatización con IA. Descubre cómo transformar tus ideas en
          soluciones potentes y automatizadas. 🚀
        </p>
      </FadeIn>

      <FadeIn client:load delay={0.4}>
        <div class="flex justify-center">
          <a
            href="https://www.youtube.com/@andreslopezco/videos"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ver videos en YouTube"
          >
            <Button
              client:only="react"
              size="lg"
              className="relative overflow-hidden px-4 hover:bg-primary/80 transition-colors duration-300 group"
            >
              <div class="shimmer"></div>
              <span class="flex items-center gap-2 relative z-10">
                Ver videos
                <ArrowRight client:only="react" className="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
              </span>
            </Button>
          </a>
        </div>
      </FadeIn>
    </div>
  </div>
</section>