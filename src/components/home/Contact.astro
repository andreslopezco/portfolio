---
import FadeIn from "@/components/react/FadeIn";
import { ArrowRight, Mail, MapPin, MessageSquare } from "lucide-react";
---

<section
  id="contacto"
  class="py-16"
  aria-label="Contacto"
>
  <FadeIn client:idle>
    <div class="space-y-4 mb-12 text-center">
      <h2 class="text-3xl font-bold tracking-tight">Contacto</h2>
      <p class="text-lg text-muted-foreground leading-relaxed max-w-2xl mx-auto">
        ¿Tienes un proyecto en mente o quieres colaborar? Estoy a un mensaje de distancia.
      </p>
    </div>
  </FadeIn>

  <div class="grid md:grid-cols-[1fr_1.5fr] gap-8 max-w-4xl mx-auto items-start">
    <!-- Info column -->
    <div class="flex flex-col gap-4">
      <FadeIn client:idle delay={0.1}>
        <div class="bg-card/50 backdrop-blur border border-border rounded-xl p-5 hover:border-primary/30 transition-colors">
          <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary/10 text-primary mb-3">
            <Mail class="w-5 h-5" />
          </div>
          <h3 class="font-semibold text-sm mb-1">Email</h3>
          <a href="mailto:hola@andreslopez.co" class="text-sm text-muted-foreground hover:text-primary transition-colors">
            hola@andreslopez.co
          </a>
        </div>
      </FadeIn>

      <FadeIn client:idle delay={0.2}>
        <div class="bg-card/50 backdrop-blur border border-border rounded-xl p-5 hover:border-primary/30 transition-colors">
          <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary/10 text-primary mb-3">
            <MapPin class="w-5 h-5" />
          </div>
          <h3 class="font-semibold text-sm mb-1">Ubicación</h3>
          <p class="text-sm text-muted-foreground">Colombia — LATAM</p>
        </div>
      </FadeIn>

      <FadeIn client:idle delay={0.3}>
        <div class="bg-card/50 backdrop-blur border border-border rounded-xl p-5 hover:border-primary/30 transition-colors">
          <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary/10 text-primary mb-3">
            <MessageSquare class="w-5 h-5" />
          </div>
          <h3 class="font-semibold text-sm mb-1">Redes</h3>
          <p class="text-sm text-muted-foreground mb-3">También puedes encontrarme aquí</p>
          <div class="flex gap-2">
            <a href="https://github.com/andreslopezco" target="_blank" rel="noopener noreferrer" class="w-9 h-9 flex items-center justify-center rounded-lg bg-primary/10 text-muted-foreground hover:text-primary hover:bg-primary/20 text-xs font-bold transition-all" aria-label="GitHub">GH</a>
            <a href="https://x.com/andreslopez_co" target="_blank" rel="noopener noreferrer" class="w-9 h-9 flex items-center justify-center rounded-lg bg-primary/10 text-muted-foreground hover:text-primary hover:bg-primary/20 text-xs font-bold transition-all" aria-label="X (Twitter)">X</a>
            <a href="https://www.instagram.com/andreslopez.co" target="_blank" rel="noopener noreferrer" class="w-9 h-9 flex items-center justify-center rounded-lg bg-primary/10 text-muted-foreground hover:text-primary hover:bg-primary/20 text-xs font-bold transition-all" aria-label="Instagram">IG</a>
            <a href="https://www.youtube.com/@andreslopezco" target="_blank" rel="noopener noreferrer" class="w-9 h-9 flex items-center justify-center rounded-lg bg-primary/10 text-muted-foreground hover:text-primary hover:bg-primary/20 text-xs font-bold transition-all" aria-label="YouTube">YT</a>
          </div>
        </div>
      </FadeIn>
    </div>

    <!-- Form column -->
    <FadeIn client:idle delay={0.2}>
      <form
        class="bg-card/50 backdrop-blur border border-border rounded-xl p-6 space-y-4"
        id="contactForm"
        action="https://formspree.io/f/xqapzbjz"
        method="POST"
      >
        <div>
          <label for="name" class="block text-sm font-medium mb-1.5">Nombre</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            minlength="2"
            placeholder="Tu nombre"
            class="w-full px-4 py-2.5 rounded-lg bg-background border border-border text-foreground text-sm focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/20 transition-all placeholder:text-muted-foreground/50"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium mb-1.5">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="tu@email.com"
            class="w-full px-4 py-2.5 rounded-lg bg-background border border-border text-foreground text-sm focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/20 transition-all placeholder:text-muted-foreground/50"
          />
        </div>
        <div>
          <label for="message" class="block text-sm font-medium mb-1.5">Mensaje</label>
          <textarea
            id="message"
            name="message"
            required
            minlength="10"
            rows="5"
            placeholder="Cuéntame de tu proyecto..."
            class="w-full px-4 py-2.5 rounded-lg bg-background border border-border text-foreground text-sm focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/20 transition-all placeholder:text-muted-foreground/50 resize-y min-h-[120px]"
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground hover:bg-primary/90 rounded-lg px-5 py-2.5 text-sm font-semibold transition-all hover:-translate-y-0.5 shadow-lg shadow-primary/20"
        >
          Enviar mensaje
          <ArrowRight class="w-4 h-4" />
        </button>
      </form>
    </FadeIn>
  </div>
</section>
