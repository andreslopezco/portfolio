---
import { Card, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import FadeIn from "@/components/react/FadeIn";
import { ArrowRight, Server, Bot, Brain, Shield, Video, Handshake } from "lucide-react";

interface Service {
  title: string;
  description: string;
  icon: string;
  link: string;
  linkLabel: string;
}

const services: Service[] = [
  {
    title: "Infraestructura & Homelab",
    description:
      "Diseño, implementación y mantenimiento de homelabs empresariales: servidores, virtualización (Proxmox/ESXi), contenedores Docker, redes y almacenamiento NAS.",
    icon: "server",
    link: "#contacto",
    linkLabel: "Saber más",
  },
  {
    title: "Automatización & DevOps",
    description:
      "Automatización de flujos: CI/CD con GitHub Actions, gestión de configuraciones con Ansible, Bash/Python scripting, y monitorización con Prometheus/Grafana.",
    icon: "bot",
    link: "#contacto",
    linkLabel: "Saber más",
  },
  {
    title: "IA & Datos",
    description:
      "Implementación de agentes de IA, integración con APIs (OpenRouter, Anthropic), procesamiento de datos, RAG, y automatización inteligente de procesos empresariales.",
    icon: "brain",
    link: "#contacto",
    linkLabel: "Saber más",
  },
  {
    title: "Seguridad & Redes",
    description:
      "Auditoría de seguridad, firewalls (pfSense/OPNsense), VPN, segmentación de redes, proxy inverso (Nginx Proxy Manager) y TLS/SSL hardening.",
    icon: "shield",
    link: "#contacto",
    linkLabel: "Saber más",
  },
  {
    title: "Contenido Técnico",
    description:
      "Creación de tutoriales, documentación técnica, guías de aprendizaje y contenido divulgativo sobre tecnología para audiencia hispanohablante.",
    icon: "video",
    link: "https://www.youtube.com/@andreslopezco/videos",
    linkLabel: "Ver contenido",
  },
  {
    title: "Consultoría Técnica",
    description:
      "Asesoría en selección de infraestructura, optimización de costos en nube, planificación de homelab, y estrategia de automatización para tu negocio.",
    icon: "handshake",
    link: "#contacto",
    linkLabel: "Agendar consulta",
  },
];

const iconMap: Record<string, any> = {
  server: Server,
  bot: Bot,
  brain: Brain,
  shield: Shield,
  video: Video,
  handshake: Handshake,
};
---

<section
  id="servicios"
  class="py-16"
  itemscope
  itemtype="https://schema.org/ItemList"
  aria-label="Servicios y consultoría"
>
  <FadeIn client:idle>
    <div class="space-y-4 mb-12 text-center">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-primary bg-primary/10 px-3 py-1 rounded-full">
        Áreas de especialización
      </span>
      <h2 class="text-3xl font-bold tracking-tight">
        Servicios & <span class="text-primary">Consultoría</span>
      </h2>
      <p class="text-lg text-muted-foreground leading-relaxed max-w-2xl mx-auto">
        Soluciones técnicas para infraestructura, automatización y contenido tech en español.
      </p>
    </div>
  </FadeIn>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" itemscope itemtype="https://schema.org/ItemList">
    {services.map((service, index) => {
      const IconComponent = iconMap[service.icon];
      return (
        <FadeIn client:idle delay={index * 0.1}>
          <Card
            client:idle
            class="bg-card/50 backdrop-blur h-full flex flex-col group hover:border-primary/30 transition-all duration-300 relative overflow-hidden"
          >
            <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-primary to-primary/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <CardContent client:idle class="flex-1 flex flex-col pt-6 gap-3">
              <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-primary/10 text-primary mb-1">
                {IconComponent && <IconComponent class="w-5 h-5" />}
              </div>
              <h3 class="text-lg font-semibold leading-tight" itemprop="name">{service.title}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed flex-1" itemprop="description">
                {service.description}
              </p>
              <a
                href={service.link}
                target={service.link.startsWith("http") ? "_blank" : undefined}
                rel={service.link.startsWith("http") ? "noopener noreferrer" : undefined}
                class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary/80 transition-colors mt-2 w-fit group/link"
                itemprop="url"
                aria-label={`${service.linkLabel}: ${service.title}`}
              >
                {service.linkLabel}
                <ArrowRight class="w-3.5 h-3.5 transition-transform duration-200 group-hover/link:translate-x-0.5" />
              </a>
            </CardContent>
          </Card>
        </FadeIn>
      );
    })}
  </div>

  <!-- Section CTA -->
  <FadeIn client:idle delay={0.3}>
    <div class="text-center mt-12">
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 bg-primary text-primary-foreground hover:bg-primary/90 rounded-xl px-6 py-3 text-sm font-semibold transition-all hover:-translate-y-0.5 shadow-lg shadow-primary/20"
      >
        Solicita una consulta gratuita
        <ArrowRight class="w-4 h-4" />
      </a>
    </div>
  </FadeIn>
</section>