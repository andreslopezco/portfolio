---
// Layout.astro
import "@/styles/global.css";
import Header from "@/components/global/Header.astro";
import Footer from "@/components/global/Footer.astro";

const {
  title = "Tecnología, Servidores, Automatización y más.",
  description = "Tutoriales, guías y recursos sobre homelab, servidores, automatización con IA y desarrollo web para Latinoamérica.",
  canonical = Astro.url,
  image = "/profile.webp",
  type = "website",
  keywords = "tecnología, servidores, homelab, automatización, IA, inteligencia artificial, desarrollo web, cloud computing, DevOps, Linux, SysAdmin, contenido tech, Latinoamérica",
} = Astro.props;

const domain = "https://andreslopez.co";
const ogImage = image.startsWith("http") ? image : `${domain}${image}`;
const ogUrl = canonical;

const personLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Andrés López",
  url: domain,
  image: `${domain}/profile.webp`,
  sameAs: [
    "https://www.youtube.com/@andreslopezco",
    "https://www.instagram.com/andreslopez.co",
    "https://github.com/andreslopezco",
  ],
  jobTitle: "Creador de contenido tecnológico",
  description: "Tutoriales, guías y contenido sobre homelab, servidores, automatización con IA y tecnología para Latinoamérica.",
  knowsAbout: ["Servidores", "Homelab", "Automatización", "Inteligencia Artificial", "Cloud Computing", "DevOps", "Linux", "Proxmox"],
});

const websiteLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Andrés López",
  url: domain,
  description: "Portafolio con tutoriales, guías y recursos sobre homelab, servidores, automatización con IA, desarrollo web y tecnología para Latinoamérica",
  inLanguage: "es-CO",
  author: {
    "@type": "Person",
    name: "Andrés López",
  },
});

---

<!DOCTYPE html>
<html lang="es-CO" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Meta tags -->
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Andrés López" />
    <meta name="robots" content="index, follow" />

    <!-- Canonical -->
    <link rel="canonical" href={ogUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Andrés López" />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@andreslopezco" />
    <meta name="twitter:site" content="@andreslopezco" />

    <!-- JSON-LD: Person -->
    <script type="application/ld+json" set:html={personLd}></script>

    <!-- JSON-LD: WebSite -->
    <script type="application/ld+json" set:html={websiteLd}></script>

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="text/markdown" href="/index.md" title="Versión Markdown" />
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
    <link rel="agent-skills" type="application/json" href="/.well-known/agent-skills/index.json" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
  </head>
  <body class="min-h-screen antialiased">
    <Header />

    <main class="flex flex-col gap-8 pt-4">
        <slot />
    </main>

    <Footer />

    <script is:inline>
      (() => {
        const modelContext = navigator.modelContext ?? document.modelContext;
        if (!modelContext || typeof modelContext.registerTool !== "function") return;

        const controller = new AbortController();
        const sections = {
          home: { hash: "#home", label: "presentación" },
          videos: { hash: "#videos", label: "últimos videos" },
          projects: { hash: "#projects", label: "proyectos reales" },
          about: { hash: "#about", label: "información sobre Andrés" },
          services: { hash: "#services", label: "servicios y consultoría" },
          contacto: { hash: "#contacto", label: "contacto" },
        };

        const registration = modelContext.registerTool({
          name: "navigate_portfolio",
          title: "Navegar por el portafolio",
          description: "Navega a una sección pública del portafolio de Andrés López.",
          inputSchema: {
            type: "object",
            properties: {
              section: { type: "string", enum: Object.keys(sections) },
            },
            required: ["section"],
            additionalProperties: false,
          },
          execute: async ({ section }) => {
            const target = sections[section];
            if (!target) return { error: "Sección no válida" };
            document.querySelector(target.hash)?.scrollIntoView({ behavior: "smooth" });
            history.replaceState(null, "", target.hash);
            return { success: true, section, label: target.label };
          },
        }, { signal: controller.signal });

        Promise.resolve(registration).catch((error) => {
          console.debug("WebMCP tool registration unavailable:", error);
        });

        window.addEventListener("pagehide", () => controller.abort(), { once: true });
      })();
    </script>
  </body>
</html>