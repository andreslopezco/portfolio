---
// Layout.astro
import "@/styles/global.css";
import Header from "@/components/global/Header.astro";
import Footer from "@/components/global/Footer.astro";
const { title = "Andrés López | Tecnología, Servidores, Automatización y más." } = Astro.props;
---
<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Portafolio de Andrés López, desarrollador y creador de soluciones digitales." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="text/markdown" href="/index.md" title="Versión Markdown" />
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
    <link rel="agent-skills" type="application/json" href="/.well-known/agent-skills/index.json" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />

    <!-- BreadcrumbList structured data (JSON-LD) -->
    <script type="application/ld+json" id="breadcrumb-jsonld">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": "https://andreslopez.co/"
          }
        ]
      }
    </script>
    <script is:inline>
      (() => {
        const sections = {
          "videos": { name: "Videos", hash: "#videos" },
          "about": { name: "Sobre mí", hash: "#about" },
        };

        function updateBreadcrumb(hash) {
          const script = document.getElementById("breadcrumb-jsonld");
          if (!script) return;

          let items = [
            { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://andreslopez.co/" }
          ];

          const section = sections[hash.replace("#", "")];
          if (section) {
            items.push({
              "@type": "ListItem",
              "position": 2,
              "name": section.name,
              "item": "https://andreslopez.co/" + section.hash
            });
          }

          script.textContent = JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": items
          }, null, 2);
        }

        // Set initial breadcrumb based on current hash
        updateBreadcrumb(window.location.hash);

        // Listen for hash changes
        window.addEventListener("hashchange", () => {
          updateBreadcrumb(window.location.hash);
        });
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <Header />

    <main class="flex flex-col gap-8 pt-[80px]">
        <slot />
    </main>

    <Footer />

    <script is:inline>
      (() => {
        const modelContext = navigator.modelContext ?? document.modelContext;
        if (!modelContext || typeof modelContext.registerTool !== "function") return;

        const controller = new AbortController();
        const sections = {
          home: { hash: "#home", label: "presentación" },
          videos: { hash: "#videos", label: "últimos videos" },
          about: { hash: "#about", label: "información sobre Andrés" },
        };

        const registration = modelContext.registerTool({
          name: "navigate_portfolio",
          title: "Navegar por el portafolio",
          description: "Navega a una sección pública del portafolio de Andrés López.",
          inputSchema: {
            type: "object",
            properties: {
              section: { type: "string", enum: Object.keys(sections) },
            },
            required: ["section"],
            additionalProperties: false,
          },
          execute: async ({ section }) => {
            const target = sections[section];
            if (!target) return { error: "Sección no válida" };
            document.querySelector(target.hash)?.scrollIntoView({ behavior: "smooth" });
            history.replaceState(null, "", target.hash);
            return { success: true, section, label: target.label };
          },
        }, { signal: controller.signal });

        Promise.resolve(registration).catch((error) => {
          console.debug("WebMCP tool registration unavailable:", error);
        });

        window.addEventListener("pagehide", () => controller.abort(), { once: true });
      })();
    </script>
  </body>
</html>
