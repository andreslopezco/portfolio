---
// Layout.astro
import "../styles/global.css";
import Header from "../components/Header.astro"
import Footer from "@/components/Footer.astro";
const { title = "Andrés López | Portafolio" } = Astro.props;
---
<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Portafolio de Andrés López, desarrollador y creador de soluciones digitales." />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="min-h-screen antialiased">
    <Header />

    <main class="flex flex-col gap-8 pt-[80px]">
        <slot />
    </main>

    <Footer />
  </body>
</html>
