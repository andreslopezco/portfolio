---
import Layout from "../layouts/Layout.astro";
import Hero from "@/components/Hero";
import YoutubeCarousel from "@/components/YoutubeCarousel";
import AboutMe from "@/components/AboutMe"
---

<Layout title="Andrés López | Tecnología, Servidores, Automatización y más.">
  {/* Hero section - full width */}
  <Hero client:load />

  {/* Content sections - constrained width */}
  <div class="flex flex-col gap-24">
    <section id="videos" class="py-12 md:py-16" aria-label="Últimos videos">
      <div class="container mx-auto max-w-5xl px-4 md:px-6">
        <YoutubeCarousel client:only="react" />
      </div>
    </section>

    <section id="about" class="py-12 md:py-16" aria-label="Información sobre mí">
      <div class="container mx-auto max-w-5xl px-4 md:px-6">
        <AboutMe />
      </div>
    </section>
  </div> 
</Layout>
