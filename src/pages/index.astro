---
import Layout from "../layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import YoutubeCarousel from "@/components/YoutubeCarousel";
import AboutMe from "@/components/AboutMe.astro"
---

<Layout title="Andrés López | Tecnología, Servidores, Automatización y más.">
  {/* Hero section - full width */}
  <Hero />

  {/* Content sections - constrained width */}
  <div class="flex flex-col gap-16">
    <div class="container mx-auto max-w-5xl px-4 md:px-6">
      <section id="videos" class="pt-8 pb-4" aria-label="Últimos videos">
        <YoutubeCarousel client:only="react" />
      </section>

      <section id="about" class="mt-16" aria-label="Información sobre mí">
        <AboutMe />
      </section>
    </div>
  </div> 
</Layout>
